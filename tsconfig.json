{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["bun"],
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true, "esModuleInterop": true
  },
  "include": ["src", "scripts/*.ts", "tests", "dashboard"]
}
