{
  "name": "tproxy",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun --use-system-ca src/cli.ts start",
    "claude": "bun --use-system-ca src/cli.ts claude",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:ui": "playwright test",
    "build:ui": "vite build --config dashboard/vite.config.ts",
    "build": "bun scripts/build.ts",
    "build:all": "bun scripts/build.ts --all",
    "package:windows": "bun scripts/package-windows.ts",
    "research:test-redaction": "python -m unittest discover -s scripts -p \"test_*.py\"",
    "research:discover": "bun scripts/discover-copilot.ts",
    "research:preflight": "bun scripts/preflight.ts",
    "research:extension": "python scripts/inspect-extension.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
